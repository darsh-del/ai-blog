# AI Blog Generator environment template
# Copy this file to .env and fill your API keys and credentials.

# ---------------------------------------------------------------------------
# API Keys & Models
# ---------------------------------------------------------------------------

# Google Gemini API key (used for image generation via Gemini Developer API)
GOOGLE_AI_STUDIO_API_KEY=

# Anthropic Claude (used for article generation via LiteLLM)
LLM_MODEL=anthropic/claude-3-5-haiku-20241022
ANTHROPIC_API_KEY=

# Optional OpenAI key (kept for fallback if configured)
OPENAI_API_KEY=

# Optional API Security Key for FastAPI Endpoints (X-API-Key header)
API_KEY=

# Image generation models
GEMINI_MODEL=gemini-2.5-flash-lite
IMAGE_MODEL=gemini-2.0-flash-preview-image-generation

# Vertex AI Settings (Set to False to use Gemini Developer API Key)
USE_VERTEX_AI=False
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# ---------------------------------------------------------------------------
# Brand and SEO identity
# ---------------------------------------------------------------------------

BRAND_NAME=BUCKETLISTT
INDUSTRY_NAME=Tourism
TARGET_CITY=Rishikesh
TARGET_STATE=Uttrakhand
BRAND_MENTION_RATIO=0.40
BRAND_PROMOTION_ENABLED=True

DEFAULT_LINK_URL=https://www.bucketlistt.com/
DEFAULT_LINK_TEXT=Explore Rishikesh Adventures on Bucketlistt
# Path segment where published posts live, used to build each article's canonical URL
# (DEFAULT_LINK_URL + BLOG_URL_PATH + slug), e.g. https://www.bucketlistt.com/blogs/<slug>
BLOG_URL_PATH=blogs

# ---------------------------------------------------------------------------
# Article generation controls
# ---------------------------------------------------------------------------

# 0.7-0.9 gives natural sentence-length variation (higher perplexity/burstiness = less
# robotic-reading text) without sacrificing coherence; below ~0.5 reads noticeably flatter.
TEMPERATURE=0.85
PRESENCE_PENALTY=0.8
FREQUENCY_PENALTY=0.6
WEBSITE_START_DATE=2024-01-01
MIN_WORD_COUNT=1500
MAX_WORD_COUNT=2000
SEO_THRESHOLD=80
MAX_ARTICLE_RETRIES=3
MAX_TOTAL_ARTICLES=50000
IMAGE_GENERATION_RATIO=1.0

# ---------------------------------------------------------------------------
# Scraper controls
# ---------------------------------------------------------------------------

SCRAPER_RAW_MODE=0
SCRAPER_PAGE_LOAD_TIMEOUT=30
SCRAPER_ELEMENT_WAIT_TIMEOUT=20
SCRAPER_MAX_RETRIES=2
SCRAPER_RETRY_DELAY=5
SCRAPER_SITE_GAP=10

# ---------------------------------------------------------------------------
# WordPress publishing
# ---------------------------------------------------------------------------

WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_TOKEN=

# ---------------------------------------------------------------------------
# SMTP Email Settings
# ---------------------------------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TO=

# Ops alert recipient — emailed (from SMTP_USERNAME) only when a real pipeline
# failure occurs: an LLM provider errors out and falls back to another provider,
# every LLM fallback is exhausted, or image generation fails across all models.
ALERT_EMAIL_TO=10102003darsh@gmail.com, divyam.shah@bucketlistt.com

# Schedule for the automated `python3 generate_and_email.py` cron job (see setup_cron.py).
# Standard 5-field cron syntax: minute hour day month weekday. Default = 10:30 AM daily.
# Change this value, then re-run `python3 setup_cron.py` to apply the new time.
GENERATE_EMAIL_CRON_SCHEDULE=30 10 * * *

# ---------------------------------------------------------------------------
# Rate limiting & Fallbacks
# ---------------------------------------------------------------------------

RATE_LIMIT_ENABLED=True
GEMINI_RPM_LIMIT_FLASH=15
LLM_FALLBACK_MODELS=anthropic/claude-3-5-haiku-20241022,anthropic/claude-3-5-sonnet-20241022,anthropic/claude-3-haiku-20240307
GEMINI_MAX_RETRIES=5
